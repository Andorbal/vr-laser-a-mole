extends Node
## Sound effects and music (autoload "Sfx").
##
## All sounds live in res://assets/audio and are generated by
## tools/generate_audio.py. 3D sounds use a pool of players so many can overlap.

const AUDIO_DIR := "res://assets/audio/"
const SOUNDS: Array[StringName] = [
	&"shot", &"hit", &"pop", &"hatch", &"escape", &"tink", &"bomb", &"combo",
	&"gold", &"armor", &"heal", &"life_lost", &"tick", &"go", &"countdown",
	&"game_over", &"ui_select", &"ui_hover", &"expand", &"new_best", &"whoosh",
]
const POOL_3D := 20
const POOL_2D := 8

var _streams: Dictionary = {}
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _pool_2d: Array[AudioStreamPlayer] = []
var _next_3d := 0
var _next_2d := 0
var _music: AudioStreamPlayer
var _music_name: StringName = &""
var _music_tween: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for sound_name in SOUNDS:
		var path := AUDIO_DIR + String(sound_name) + ".wav"
		if ResourceLoader.exists(path):
			_streams[sound_name] = load(path)
	for track in [&"music_menu", &"music_game"]:
		var path := AUDIO_DIR + String(track) + ".ogg"
		if ResourceLoader.exists(path):
			var stream: AudioStream = load(path)
			if stream is AudioStreamOggVorbis:
				(stream as AudioStreamOggVorbis).loop = true
			_streams[track] = stream

	for i in POOL_3D:
		var p := AudioStreamPlayer3D.new()
		p.bus = &"SFX"
		p.unit_size = 4.0
		p.max_polyphony = 2
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p)
		_pool_3d.append(p)
	for i in POOL_2D:
		var p := AudioStreamPlayer.new()
		p.bus = &"SFX"
		add_child(p)
		_pool_2d.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = &"Music"
	add_child(_music)


func _exit_tree() -> void:
	# Release audio streams so nothing is reported as leaked on quit.
	if _music_tween:
		_music_tween.kill()
	_music.stop()
	_music.stream = null
	for p in _pool_3d:
		p.stop()
		p.stream = null
	for p in _pool_2d:
		p.stop()
		p.stream = null
	_streams.clear()


func _setup_buses() -> void:
	if AudioServer.get_bus_index(&"SFX") == -1:
		AudioServer.add_bus()
		var idx := AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, &"SFX")
		AudioServer.set_bus_send(idx, &"Master")
		var reverb := AudioEffectReverb.new()
		reverb.room_size = 0.55
		reverb.damping = 0.6
		reverb.spread = 0.8
		reverb.wet = 0.12
		reverb.dry = 1.0
		AudioServer.add_bus_effect(idx, reverb)
	if AudioServer.get_bus_index(&"Music") == -1:
		AudioServer.add_bus()
		var idx := AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, &"Music")
		AudioServer.set_bus_send(idx, &"Master")
		AudioServer.set_bus_volume_db(idx, -5.0)


func has_sound(sound_name: StringName) -> bool:
	return _streams.has(sound_name)


## Plays a non-positional sound (UI, announcer).
func play(sound_name: StringName, volume_db := 0.0, pitch := 1.0) -> void:
	if not _streams.has(sound_name):
		return
	var p := _pool_2d[_next_2d]
	_next_2d = (_next_2d + 1) % _pool_2d.size()
	p.stream = _streams[sound_name]
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


## Plays a sound from a point in the world, so the player can hear where it is.
func play_at(sound_name: StringName, pos: Vector3, volume_db := 0.0, pitch := 1.0) -> void:
	if not _streams.has(sound_name):
		return
	var p := _pool_3d[_next_3d]
	_next_3d = (_next_3d + 1) % _pool_3d.size()
	p.stream = _streams[sound_name]
	p.global_position = pos
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


func play_music(track: StringName) -> void:
	if not Save.music_enabled:
		_music_name = track
		_music.stop()
		return
	if track == _music_name and _music.playing:
		return
	_music_name = track
	if not _streams.has(track):
		return
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween()
	if _music.playing:
		_music_tween.tween_property(_music, "volume_db", -40.0, 0.6)
	_music_tween.tween_callback(func() -> void:
		_music.stream = _streams[track]
		_music.volume_db = -40.0
		_music.play())
	_music_tween.tween_property(_music, "volume_db", 0.0, 0.8)


func set_music_enabled(on: bool) -> void:
	Save.set_music_enabled(on)
	if on:
		var track := _music_name
		_music_name = &""
		play_music(track if track != &"" else &"music_menu")
	else:
		if _music_tween:
			_music_tween.kill()
		_music.stop()
